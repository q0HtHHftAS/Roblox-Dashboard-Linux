// Prisma schema for StealDashbord multi-user with Discord OAuth
generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  discordId     String?   @unique
  name          String?
  email         String?   @unique
  image         String?
  apiKey        String?   @unique
  shareToken    String?   @unique
  shareEnabled  Boolean   @default(false)
  maskUsernames Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  players       Player[]
  // ---- Admin / 2FA ----
  // totpSecret เก็บแบบเข้ารหัสด้วย key จาก env เท่านั้น (ห้าม plaintext)
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  totpEnabledAt DateTime?
  // backupCodes = JSON array ของ sha256 hex (ใช้ครั้งเดียวทิ้ง)
  backupCodes   String    @default("[]")
  // block = ห้าม login + ห้ามยิง ingest
  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Player {
  id           String   @id @default(cuid())
  userId       String
  pcName       String
  robloxUserId String?
  username     String
  gameId       String   @default("stealanegg")
  data         String   // JSON stringified PlayerData
  firstSeen    BigInt
  lastSeen     BigInt
  lastUpdated  BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, pcName, username])
  @@index([userId])
  @@index([gameId])
}

// บันทึก action ของ admin เท่านั้น (login/2FA/CRUD user/block/settings) — retention 90 วัน
model AdminAuditLog {
  id              String   @id @default(cuid())
  actorDiscordId  String
  action          String
  detail          String?
  ip              String?
  createdAt       DateTime @default(now())
  @@index([createdAt])
  @@index([actorDiscordId])
}

// ตั้งค่าเว็บระดับ DB (แก้ผ่าน Admin Panel ได้โดยไม่ restart)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ยอดรวมรายวันสำหรับกราฟ admin (pageview + api hits) — retention 90 วัน
model DailyStat {
  date      String @id // YYYY-MM-DD (UTC)
  pageviews Int    @default(0)
  apiHits   Int    @default(0)
  // JSON map: { "/api/live": 123 } — ยอดแยกตาม route ของ apiHits
  routes    String @default("{}")
  // snapshot ยอดนับสำหรับป้าย % เทียบเมื่อวาน (เขียนแบบ throttle จาก /api/live)
  snapUsers   Int?
  snapPlayers Int?
  snapOnline  Int?
}
