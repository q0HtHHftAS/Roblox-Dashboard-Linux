# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local SQLite (มี apiKey/shareToken + ข้อมูลผู้เล่นเป็น plaintext — ห้าม commit)
prisma/*.db*
*.db-shm
*.db-wal

# dev logs + decoder scratch files (อาจมีข้อมูลรันไทม์, ไม่ใช่ source)
*.log
dump_*.txt
h_dump.txt
w0_entries.txt
x_calls_output.txt
y0_lookup*.txt

# one-off reverse-engineering scratch (ย้ายเข้า archive/, ไม่เข้า commit แรก)
archive/
